@Library('hobom-shared-lib') _
hobomPipeline(
  serviceName:    'dev-for-hammer-frontend',
  hostPort:       '3001',
  containerPort:  '8080',
  memory:         '256m',
  cpus:           '0.5',
  submodules:     false,
  dockerfilePath: 'apps/hammer-system',
  preBuild:       { sh '''
    set -eux
    docker run --rm -v "$PWD":/app -w /app node:20 sh -c \
      'rm -rf node_modules apps/*/node_modules apps/*/dist packages/*/node_modules packages/*/dist .pnpm-store'
    git clean -fdx -e apps/hammer-system/.env
    cp /etc/hobom-dev/dev-for-hammer-frontend/.env apps/hammer-system/.env
    docker run --rm \
      -v "$PWD":/app -w /app node:20 sh -c '
        corepack enable &&
        pnpm install --frozen-lockfile &&
        pnpm build:hammer
      '
    rm -f apps/hammer-system/.env
  ''' },
  smokeCheckPath: '/healthz'
)
