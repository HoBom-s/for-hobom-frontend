{
  "entry": ["src/**/*.spec.{ts,tsx}", "eslint.config.js"],
  "project": ["src/**/*.{ts,tsx}", "eslint-rules/**/*.js"],
  "paths": {
    "@/*": ["src/*"]
  },
  "ignoreDependencies": [
    "hobom-design-system",
    "hobom-utils",
    "hobom-data",
    "hobom-schema",
    "vitest",
    "@testing-library/react",
    "happy-dom",
    "globals",
    "eslint-plugin-react-hooks",
    "eslint-plugin-react-refresh",
    "typescript-eslint"
  ],
  "ignoreBinaries": ["tsc", "eslint", "prettier", "vitest", "knip"]
}
