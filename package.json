{
  "name": "hobom-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev:hobom": "pnpm --filter hobom-system dev",
    "build:hobom": "pnpm --filter hobom-system build",
    "typecheck": "pnpm -r --parallel typecheck",
    "lint": "pnpm -r --parallel lint",
    "lint:fix": "pnpm -r --parallel exec eslint --fix .",
    "test": "pnpm -r --parallel exec vitest run",
    "test:coverage": "pnpm -r --parallel exec vitest run --coverage",
    "format": "prettier . --write",
    "knip": "knip"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^10.6.0",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "happy-dom": "^20.7.0",
    "jsdom": "^29.1.1",
    "knip": "^5.84.1",
    "prettier": "^3.4.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.62.1",
    "vitest": "^4.1.9"
  },
  "pnpm": {
    "overrides": {
      "react": "19.2.7",
      "react-dom": "19.2.7",
      "@types/react": "19.2.14",
      "@types/react-dom": "19.2.3",
      "dompurify": ">=3.4.11",
      "react-router-dom": ">=7.18.1",
      "react-router": ">=7.18.1",
      "vite": ">=8.1.3",
      "vitest": ">=4.1.10",
      "@vitest/coverage-v8": ">=4.1.10",
      "happy-dom": ">=20.10.6",
      "flatted@<=3.4.1": ">=3.4.2",
      "smol-toml@<1.6.1": ">=1.6.1",
      "brace-expansion@>=4.0.0 <5.0.5": ">=5.0.5",
      "brace-expansion@>=5.0.0 <5.0.6": ">=5.0.6",
      "picomatch@<2.3.2": ">=2.3.2",
      "picomatch@>=4.0.0 <4.0.4": ">=4.0.4",
      "yaml@>=1.0.0 <1.10.3": ">=1.10.3",
      "yaml@>=2.0.0 <2.8.3": ">=2.8.3",
      "ws@>=8.0.0 <8.21.0": ">=8.21.0",
      "esbuild@>=0.27.3 <0.28.1": ">=0.28.1",
      "@babel/core@<=7.29.0": ">=7.29.6"
    }
  }
}
