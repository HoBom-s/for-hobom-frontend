{
  "entry": ["src/main.tsx", "src/**/*.spec.{ts,tsx}", "eslint.config.js"],
  "project": ["src/**/*.{ts,tsx}", "eslint-rules/**/*.js"],
  "paths": {
    "@/*": ["src/*"]
  },
  "ignoreDependencies": ["hobom-design-system", "hobom-utils", "typescript-eslint"],
  "ignoreBinaries": ["tsc", "eslint", "prettier"]
}
