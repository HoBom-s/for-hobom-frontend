@Library('hobom-shared-lib') _
hobomPipeline(
  serviceName:    'dev-for-hobom-frontend',
  hostPort:       '3000',
  containerPort:  '8080',
  memory:         '256m',
  cpus:           '0.5',
  submodules:     false,
  preBuild:       { sh '''
    set -eux
    git clean -fdx -e apps/hobom-system/.env
    cp /etc/hobom-dev/dev-for-hobom-frontend/.env apps/hobom-system/.env
    docker run --rm \
      -v "$PWD":/app -w /app node:20 sh -c '
        corepack enable &&
        pnpm install --frozen-lockfile &&
        pnpm build
      '
    rm -f apps/hobom-system/.env
  ''' },
  smokeCheckPath: '/healthz'
)
